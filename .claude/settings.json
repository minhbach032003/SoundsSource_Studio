{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm build)",
      "Bash(pnpm check)",
      "Bash(node tests/:*)",
      "Bash(npx @fission-ai/openspec validate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Bash(pnpm rebuild:app)",
      "Bash(pnpm tauri:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
