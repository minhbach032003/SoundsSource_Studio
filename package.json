{
  "name": "rust-sound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "pnpm tauri dev",
    "build": "tsc && vite build",
    "rebuild:app": "rm -rf dist target/release/bundle && pnpm tauri build --bundles app && rm -rf /Applications/rust-sound.app && cp -R target/release/bundle/macos/rust-sound.app /Applications/ && echo 'Successfully deployed /Applications/rust-sound.app'",
    "preview": "vite preview",
    "tauri": "TAURI_APP_PATH=crates/app TAURI_FRONTEND_PATH=. tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.2.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
